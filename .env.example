# Copiez ce fichier vers .env. Ne versionnez jamais votre vraie clé.

# Fournisseur actif : deepseek, nvidia ou gemini
AI_PROVIDER=deepseek

# API DeepSeek directe — configuration principale
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# NVIDIA API Catalog / NIM, facultatif
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# API Gemini, facultative
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

NOVA_DB_PATH=data/nova.db
